# Desarrollo local. Wrangler crea las instancias locales de D1 y R2.
DATABASE_URL="file:./local.db"
APP_URL="http://localhost:3000"
# Configura APP_SECRET en los secretos de Sites en producción.
APP_SECRET=""
CRON_SECRET=""
# Solo para configurar el primer administrador a través de la sesión de Sites.
SITES_OWNER_EMAIL=""
# Semilla local opcional de administrador.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
# IA opcional.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Stripe del propietario de la plataforma.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Correo HTTPS mediante Resend o un relay HTTPS de SMTP.
RESEND_API_KEY=""
MAIL_FROM=""
SMTP_URL=""
SMTP_RELAY_URL=""
SMTP_RELAY_TOKEN=""
