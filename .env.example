DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/encauza"
APP_URL="http://localhost:3000"
# 64 caracteres hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""
# IA (Claude). Sin clave, las funciones de IA indican que falta configurarla.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Cobro de suscripciones de la plataforma (Stripe del propietario del SaaS)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Correo de la plataforma (smtp://user:pass@host:587). Cada cuenta puede poner su propio SMTP.
SMTP_URL=""
MAIL_FROM="Encauza <no-reply@tu-dominio.com>"
# Carpeta para archivos subidos
UPLOAD_DIR="./storage"
# Secreto para /api/cron (si no se define, se usa APP_SECRET)
CRON_SECRET=""
# Correo del primer superadministrador (se crea con npm run db:seed)
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
